{
  "name": "srg-calendar-desktop",
  "productName": "Calendar App",
  "version": "1.6.1",
  "description": "Calendar App for Windows",
  "author": "S Rathina Giri",
  "private": true,
  "main": "main.js",
  "scripts": {
    "prepare-web": "node ../scripts/build-web.mjs && node -e \"require('fs').cpSync('../www','app-www',{recursive:true})\"",
    "start": "npm run prepare-web && electron .",
    "dist:win": "npm run prepare-web && electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.srathinagiri.calendar.desktop",
    "productName": "Calendar App",
    "artifactName": "CalendarApp-Setup-${version}.${ext}",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "app-www/**/*", "package.json"],
    "asar": true,
    "win": { "target": "nsis", "icon": "build/icon.ico" },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Calendar App"
    }
  }
}
